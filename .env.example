# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/main
DATABASE_SSL=false
DB_POOL_MAX=10

# Better Auth
BETTER_AUTH_SECRET=replace-with-a-64-char-hex-secret
BETTER_AUTH_URL=http://localhost:3000

# App
NODE_ENV=development
VITE_APP_ENV=development

# Offline attendance Excel import (disabled until pilot approval)
OFFLINE_ATTENDANCE_IMPORT_ENABLED=false
OFFLINE_ATTENDANCE_SIGNING_KEYS={"1":"replace-with-base64-32-byte-key"}
OFFLINE_ATTENDANCE_ACTIVE_SIGNING_VERSION=1

# Offline sales Excel import (disabled until factory drill approval)
OFFLINE_SALES_IMPORT_ENABLED=false
OFFLINE_SALES_SIGNING_KEYS={"1":"replace-with-base64-32-byte-key"}
OFFLINE_SALES_ACTIVE_SIGNING_VERSION=1

# Super admin bootstrap (critical)
ADMIN_BOOTSTRAP_SECRET=replace-with-a-long-random-secret
ALLOW_PUBLIC_SIGNUP=false
